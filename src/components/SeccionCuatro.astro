<section class="seccionCuatro" id="contacto">
  <div class="container-main">
    <div class="contacto-wrap">
      <div class="contacto-header" data-aos="fade-up" data-aos-duration="1000">
        <p class="section-kicker">CONTACTO · PROPUESTAS · OPORTUNIDADES</p>
        <h2 class="subtitle">Contacto</h2>
        <p class="section-description">
          Si querés ponerte en contacto conmigo para colaborar en un proyecto,
          desarrollar una web o conversar sobre una propuesta laboral, completá
          el formulario y te responderé a la brevedad.
        </p>
      </div>

      <div class="contacto-grid">
        <div
          class="card-glass contacto-info"
          data-aos="fade-right"
          data-aos-duration="1100"
        >
          <h3>Hablemos</h3>
          <p>
            Estoy abierto a nuevas oportunidades relacionadas con desarrollo
            web, automatización, tecnología y mejora de procesos.
          </p>

          <div class="contacto-datos">
            <a
              href="https://github.com/MKranauerDev"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-brands fa-github"></i>
              <span>GitHub</span>
            </a>

            <a
              href="https://www.linkedin.com/in/mkranauer"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-brands fa-linkedin"></i>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        <form
          id="contact-form"
          class="card-glass contacto-form"
          data-aos="fade-left"
          data-aos-duration="1100"
        >
          <div id="form-alert" class="form-alert hidden">
            <span id="form-alert-text"></span>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre</label>
              <input
                type="text"
                id="nombre"
                name="name"
                placeholder="Tu nombre"
              />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="tuemail@email.com"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="asunto">Asunto</label>
            <input
              type="text"
              id="asunto"
              name="subject"
              placeholder="Motivo del mensaje"
            />
          </div>

          <div class="form-group">
            <label for="mensaje">Mensaje</label>
            <textarea
              id="mensaje"
              name="message"
              rows="6"
              placeholder="Contame un poco sobre tu propuesta o consulta..."
            ></textarea>
          </div>

          <button type="button" id="send-btn" class="btn-contacto-submit">
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script defer src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"
></script>
<script defer src="/js/contacto.js"></script>
